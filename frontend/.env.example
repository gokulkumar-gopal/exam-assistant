# Frontend environment (frontend-spec 8.1). Copy to .env.local for local development:
#   cp .env.example .env.local
# .env.local is gitignored. Never put a secret in this example file.

# Base URL of the backend, used only by the /api/:path* rewrite in next.config.ts.
# Server-side only: there is deliberately no NEXT_PUBLIC_API_URL, because the browser
# never calls AWS directly except for the S3 upload and file-view URLs the backend hands out.
# No trailing slash. Leave unset when running with MOCK_API=true (the rewrite is then skipped).
API_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# Google OAuth web client ID for the Google sign-in button.
# Public by design, not a secret. Inlined at build time, so redeploy after changing it.
# localhost:3000 must be an authorized JavaScript origin on this client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# Serve local JSON fixtures instead of calling the backend, and start signed in as a demo
# teacher. Lets the frontend run before the backend exists; the Google button is replaced
# by "Continue as demo user". next.config.ts maps this to NEXT_PUBLIC_MOCK_API, so setting
# NEXT_PUBLIC_MOCK_API directly has no effect.
MOCK_API=false

# With MOCK_API=true, start signed out instead, to exercise the route guards.
NEXT_PUBLIC_MOCK_SIGNED_OUT=false
